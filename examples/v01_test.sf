error MathError ( DivisionByZero, Overflow )

func div!(a: int, b: int) -> int
  raise MathError.DivisionByZero if b == 0
  return a / b
end

func safe_div(a: int, b: int) -> int
  result: int = try div!(a, b)
  return result
end

func add(a: int, b: int) -> int
  return a + b
end

pub func main() -> void
  x: int = add(3, 4)
  if x > 5
    println('big')
  else
    println('small')
  end

  safe: int = safe_div(10, 0)
  println(f'safe_div result: {safe}')

  good: int = div!(10, 2)
  println(f'10 / 2 = {good}')

  mut i: int = 0
  while i < 3
    println(f'{i}')
    i = i + 1
  end
end
