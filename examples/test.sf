# Single line comment

#[ Multiline comment ]#

##[ Documentation ]##

func greeting(name: string) -> void
  println(f'Hello {name}')
end

greeting('world')

# Numbers
x: int = 42
y: float = 3.14
big: int = 1_000_000
hex: int = 0xFF
bin: int = 0b1010
sci: float = 1.5e10

# Strings
msg: string = 'hello world'
multi: string = '''
  line one
  line two
'''

# Bool
flag: bool = true
other: bool = false

# Mutable variable
mut count: int = 0
count = count + 1

# Failable and bool-returning function names
func divide!(a: int, b: int) -> int
  raise MathError.DivisionByZero if b == 0
  return a / b
end

func positive?(n: int) -> bool
  return n > 0
end

# Range and for loop
for i in 0..10
  skip if i == 5
end

for i in 0..=10
  break if i == 10
end

# Match
match x
  0 => 'zero'
  with n if n < 0 => 'negative'
  _ => 'positive'
end

# Array
mut items: [int] = [reserve 10]
items.push(1)
items.push(2)

# Module path
import std::io as io
import std::math::{ sqrt }

# Constants
const MAX: int = 100

# Operators
a: int = 1 + 2 - 3 * 4 / 2 % 3
b: bool = a == 0 and not flag or other
c: bool = a != 1 and a >= 0 and a <= 100

# Struct construction
p: Point = Point { x: 1.0, y: 2.0 }

# Path separator
val: int = MyModule::CONSTANT
