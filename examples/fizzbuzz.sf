mut i: int = 1

for i in 1..=20
  mut is_fizz: bool = i % 3 == 0
  mut is_buzz: bool = i % 5 == 0

  if is_fizz and is_buzz
    println('FizzBuzz')
  else
    if is_fizz
      println('Fizz')
    else
      if is_buzz
        println('Buzz')
      else
        println(i)
      end
    end
  end
end
