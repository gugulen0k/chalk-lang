func is_even(n: int) -> bool
  return n % 2 == 0
end

func in_range(n: int, lo: int, hi: int) -> bool
  return n >= lo and n <= hi
end

println(f'{is_even(4)}')
println(f'{is_even(7)}')
println(f'{in_range(5, 1, 10)}')
println(f'{in_range(15, 1, 10)}')

a: bool = true
b: bool = false
println(f'{a and b}')
println(f'{a or b}')
println(f'{not a}')
